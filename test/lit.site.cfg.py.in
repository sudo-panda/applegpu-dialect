@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.applegpu_obj_root = "@APPLEGPU_BINARY_DIR@"
config.triton_python = "@APPLEGPU_TRITON_PYTHON@"
config.triton_opt = "@APPLEGPU_TRITON_OPT@"
config.triton_tensor_layout = "@APPLEGPU_TRITON_TENSOR_LAYOUT@"
config.apple_triton_plugin = "@APPLEGPU_TRITON_PLUGIN@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, "@APPLEGPU_SOURCE_DIR@/test/lit.cfg.py")
